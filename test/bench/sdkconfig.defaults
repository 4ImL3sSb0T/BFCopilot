# Hardware test firmware for the butterfly PCB.
#
# It links only the components that own hardware and runs none of the flight logic, so a
# bring-up test can never be blocked by an arming or fault state. Not the flight firmware:
# never flash it on a vehicle meant to fly.
#
# The console is the ESP32-C6 USB-Serial-JTAG port, shared with flashing. The host tool
# (tools/bf_station.py) opens that virtual COM port, so there is no Wi-Fi credential to
# configure and no local.defaults is needed.
#
#   scripts/idf.sh -C test/bench -B "$PWD/test/bench/build" build
#
CONFIG_IDF_TARGET="esp32c6"

# Primary console on USB Serial/JTAG; UART0 is not exposed on the programming port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The module probes as 4 MB; keep headroom for the hardware-test image.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
