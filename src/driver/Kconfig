menu "BFCopilot radio"
config BF_RADIO_ENABLED
    bool "Enable explicitly provisioned encrypted ESP-NOW peer"
    default n
config BF_RADIO_CHANNEL
    int "Fixed Wi-Fi channel"
    range 1 11
    default 6
config BF_RADIO_PEER
    string "Peer station MAC (12 hexadecimal digits)"
    default ""
config BF_RADIO_PMK
    string "PMK (32 hexadecimal digits)"
    default ""
config BF_RADIO_LMK
    string "LMK (32 hexadecimal digits)"
    default ""
endmenu

menu "BFCopilot Wi-Fi direct link"
config BF_WIFI_LINK_ENABLED
    bool "Enable Wi-Fi + UDP control link (bench)"
    default n
    help
        Flight controller accepts the same 60-byte control frames over UDP,
        either as an access point or as a station on an existing one. Mutually
        exclusive with the ESP-NOW peer. There is no application-layer
        authentication: bench/indoor only, never a flight-worthy link.

choice BF_WIFI_LINK_MODE
    prompt "Link mode"
    default BF_WIFI_LINK_MODE_STA
    depends on BF_WIFI_LINK_ENABLED
    config BF_WIFI_LINK_MODE_AP
        bool "Flight controller runs its own access point"
    config BF_WIFI_LINK_MODE_STA
        bool "Flight controller joins an existing access point"
endchoice

config BF_WIFI_STA_SSID
    string "Upstream SSID"
    default ""
    depends on BF_WIFI_LINK_ENABLED && BF_WIFI_LINK_MODE_STA

config BF_WIFI_STA_PASSWORD
    string "Upstream WPA2 passphrase (8..63 characters; empty = open)"
    default ""
    depends on BF_WIFI_LINK_ENABLED && BF_WIFI_LINK_MODE_STA

config BF_WIFI_AP_SSID
    string "Access point SSID"
    default "BFCopilot"
    depends on BF_WIFI_LINK_ENABLED && BF_WIFI_LINK_MODE_AP

config BF_WIFI_AP_PASSWORD
    string "Access point WPA2 passphrase (8..63 characters; empty = open)"
    default ""
    depends on BF_WIFI_LINK_ENABLED && BF_WIFI_LINK_MODE_AP

config BF_WIFI_AP_CHANNEL
    int "Wi-Fi channel"
    range 1 11
    default 6
    depends on BF_WIFI_LINK_ENABLED && BF_WIFI_LINK_MODE_AP

config BF_WIFI_LINK_PORT
    int "UDP control port"
    range 1024 65535
    default 3335
    depends on BF_WIFI_LINK_ENABLED

config BF_WIFI_LINK_BENCH_TIMING
    bool "Relax control timing for bench Wi-Fi (300 ms TTL / 500 ms lease)"
    default n
    depends on BF_WIFI_LINK_ENABLED
    help
        Allow hotspot scheduling jitter during supervised bench tests.
        This delays control-loss protection. Keep disabled for strict timing.
        Emergency stop processing remains immediate.
endmenu
